# Production environment config — non-sensitive settings only.
# AWS credentials are read from ~/.aws/credentials. Set AWS_PROFILE to select a profile.

AWS_PROFILE=
AWS_REGION=us-east-1

BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_DISABLE_SSL_VERIFY=false

MEMORY_ENCRYPTION_KEY=
MEMORY_PASSPHRASE=
MEMORY_MAX_ACTIVE_TURNS=20
MEMORY_MAX_ACTIVE_TOKENS=12000

# Use a fixed port in production so load balancers can target it
CODEONTOLOGY_PORT=8000
