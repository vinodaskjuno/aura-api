# Staging environment config — non-sensitive settings only.
# AWS credentials are read from ~/.aws/credentials. Set AWS_PROFILE to select a profile.

AWS_PROFILE=
AWS_REGION=us-east-1

LLM_BACKEND=bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_DISABLE_SSL_VERIFY=false

MEMORY_ENCRYPTION_KEY=
MEMORY_PASSPHRASE=
MEMORY_MAX_ACTIVE_TURNS=12
MEMORY_MAX_ACTIVE_TOKENS=8000

CODEONTOLOGY_PORT=0
