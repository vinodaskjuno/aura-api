# Development environment config — non-sensitive settings only.
# AWS credentials are read from ~/.aws/credentials. Set AWS_PROFILE to select a profile.

# AWS profile from ~/.aws/credentials (leave blank to use [default])
AWS_PROFILE=default
AWS_REGION=us-east-1

# Bedrock model (inference profile id enabled in your account/region)
LLM_BACKEND=bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Set true only if a corporate TLS proxy breaks boto3 SSL verification
BEDROCK_DISABLE_SSL_VERIFY=false

# Encrypted conversation memory
MEMORY_ENCRYPTION_KEY=
MEMORY_PASSPHRASE=
MEMORY_MAX_ACTIVE_TURNS=12
MEMORY_MAX_ACTIVE_TOKENS=8000

# Server port (0 = auto-pick; printed as PORT=<n> for the extension to discover)
CODEONTOLOGY_PORT=0
